APP_NAME="Measuring Well-Being"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Beirut

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local development uses the MySQL container from docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sdq
DB_USERNAME=sdq
DB_PASSWORD=sdq

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mailpit in docker-compose captures all mail locally.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@measuringwellbeing.org"
MAIL_FROM_NAME="${APP_NAME}"

# First administrator, created by `php artisan db:seed` when both are set.
SDQ_ADMIN_EMAIL=
SDQ_ADMIN_PASSWORD=
SDQ_ADMIN_FIRSTNAME=UNICEF
SDQ_ADMIN_LASTNAME=Admin

# SDQ behaviour (see config/sdq.php)
SDQ_SCORING_POLICY=documented
SDQ_MAX_NA_ANSWERS=3
SDQ_CODE_FORMAT="{year}-{partner}-{collector}-{n}"
SDQ_QUOTA_PER_YEAR=true
SDQ_APK_URL=

# Azure (production): set through Container Apps secrets / Key Vault, never here.
# AZURE_STORAGE_CONNECTION_STRING=
# APPLICATIONINSIGHTS_CONNECTION_STRING=

VITE_APP_NAME="${APP_NAME}"
