{
	frankenphp
	order php_server before file_server
	auto_https off
}

{$SERVER_NAME}

log {
	output stdout
	format json
}

root * /app/public
encode zstd gzip

# The Android application in the field calls the legacy host paths
# (https://measuringwellbeing.org/prod/api/... and /staging/api/...).
# Rewrite them to the legacy-compatible API routes.
@legacyApi path_regexp legacyApi ^/(prod|staging)/api/(.*)$
rewrite @legacyApi /api/{re.legacyApi.2}

# Static assets built by Vite are immutable (hashed file names).
@assets path /build/*
header @assets Cache-Control "public, max-age=31536000, immutable"

header {
	X-Content-Type-Options nosniff
	X-Frame-Options SAMEORIGIN
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}

php_server
